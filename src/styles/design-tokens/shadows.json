{
  "elevation": {
    "dropdown": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0rem",
        "offsetY": "0.75rem",
        "blur": "2rem",
        "spread": "0rem",
        "color": "{semantic.surface.overlay}"
      }
    },
    "modal": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0rem",
        "offsetY": "1.5rem",
        "blur": "5rem",
        "spread": "0rem",
        "color": "{semantic.surface.overlay}"
      }
    },
    "board": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0rem",
        "offsetY": "0.75rem",
        "blur": "2rem",
        "spread": "-1rem",
        "color": "{semantic.surface.overlay}"
      }
    }
  }
}
