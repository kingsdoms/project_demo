{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "radius": {
    "none": { "$type": "dimension", "$value": "0rem" },
    "sm": { "$type": "dimension", "$value": "0.25rem" },
    "md": { "$type": "dimension", "$value": "0.375rem" },
    "lg": { "$type": "dimension", "$value": "0.5rem" },
    "xl": { "$type": "dimension", "$value": "0.75rem" },
    "2xl": { "$type": "dimension", "$value": "1rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "radius-semantic": {
    "button": { "$type": "dimension", "$value": "{radius.md}" },
    "input": { "$type": "dimension", "$value": "{radius.md}" },
    "card": { "$type": "dimension", "$value": "{radius.lg}" },
    "panel": { "$type": "dimension", "$value": "{radius.xl}" },
    "modal": { "$type": "dimension", "$value": "{radius.2xl}" },
    "badge": { "$type": "dimension", "$value": "{radius.full}" }
  }
}
